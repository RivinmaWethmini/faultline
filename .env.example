# -----------------------------------------------------------------------------
# Local Development (Docker Compose)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=faultline
POSTGRES_PASSWORD=faultline_secret
POSTGRES_DB=faultline

REDIS_HOST=redis
REDIS_PORT=6379

SERVER_PORT=8080
LOG_LEVEL=info

VITE_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Production Deployment (Render & Vercel)
# -----------------------------------------------------------------------------
# Backend (Render Web Service):
# PORT=10000 (automatically assigned by Render)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# REDIS_URL=rediss://default:password@host:6379 (e.g. from Upstash or Render Key-Value)
# REDIS_OPTIONAL=true (set to true if running on a free plan without Redis)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Frontend (Vercel Project Settings):
# VITE_API_URL=https://your-backend.onrender.com
